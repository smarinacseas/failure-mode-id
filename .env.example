# Copy to .env and fill in. Both keys are required.
# Candidates run via OpenRouter; judges/classifier/diagnosis via Anthropic.
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...

# Training-track proxy (only needed for proxy:// candidates — see training/proxy.py)
# TINKER_API_KEY=tk-...
# PROXY_BASE_URL=http://127.0.0.1:8000/v1
# PROXY_API_KEY=local-dev
# HF_TOKEN=hf_...            # only if the VerIH dataset is gated
